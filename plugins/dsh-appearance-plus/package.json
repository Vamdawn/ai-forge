{
  "name": "@vamdawn/dsh-appearance-plus",
  "version": "0.1.0",
  "description": "Customize DeepSeek Harness interface fonts, code fonts, and background image",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vamdawn/ai-forge.git",
    "directory": "plugins/dsh-appearance-plus"
  },
  "homepage": "https://github.com/Vamdawn/ai-forge/tree/main/plugins/dsh-appearance-plus#readme",
  "bugs": {
    "url": "https://github.com/Vamdawn/ai-forge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "font",
    "background",
    "appearance"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tests.json",
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "npm test",
    "prepare": "npm run build",
    "prepack": "npm run typecheck"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "fontkit": "2.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT"
}
